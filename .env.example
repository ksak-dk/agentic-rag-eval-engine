# =============================================================================
# Environment Variables Template — agentic-rag-eval-engine
# Copy to .env and fill in your values. NEVER commit .env to Git.
# =============================================================================

# --- Cloud LLM API Keys ---
# Groq (free tier) — Fast Route: llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio (free tier) — Strong Route: gemini-2.5-flash
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# --- Langfuse (optional observability — requires docker compose --profile observability up) ---
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000

# --- Infrastructure URLs ---
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# --- Pipeline Control ---
# Options: v1 | v2 | v3
PIPELINE_VERSION=v3

# --- Mock Mode (for load testing & CI without consuming API quota) ---
# true = mock LLM stream (300ms TTFT, simulated token stream)
# false = real end-to-end with Groq/Gemini APIs
MOCK_LLM_STREAM=false

# --- Local CUDA Device (auto-detected, override if multi-GPU) ---
# CUDA_VISIBLE_DEVICES=0

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Qdrant Collection ---
QDRANT_COLLECTION_NAME=rag_documents

# --- Retrieval Hyperparameters ---
# Top-K after reranking (final context sent to LLM)
RETRIEVAL_TOP_K=5
# Top-N candidates fetched before reranking
RETRIEVAL_TOP_N=20

# --- Redis Semantic Cache ---
# Cosine similarity threshold for cache hit (0.0 - 1.0)
CACHE_SIMILARITY_THRESHOLD=0.92
# TTL for cached responses in seconds (24 hours)
CACHE_TTL_SECONDS=86400

# --- LangGraph ---
LANGGRAPH_CHECKPOINT_DB=./data/langgraph_checkpoints.sqlite3
# Hard cap on grader→rewriter retry loops (prevents infinite loops)
MAX_RETRIES=2
