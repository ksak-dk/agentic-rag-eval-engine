# Normalize line endings to LF in the repository, checkout as-is on Windows
* text=auto eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf
*.lock text eol=lf

# Binary files
*.png binary
*.jpg binary
*.safetensors binary
*.bin binary
*.pt binary
*.onnx binary
